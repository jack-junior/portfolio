---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import BarFigure from '../components/BarFigure.astro';
import { ui, url, monthYear, type Lang } from '../lib/i18n';
import { getProfile, getNews, getProjects, getPublications } from '../lib/data';
import { figures } from '../lib/figures';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const p = getProfile(lang);
const highlights = (await getNews(lang)).filter((n) => n.data.highlight).slice(0, 4);
const work = (await getProjects(lang)).filter((x) => x.data.featured).slice(0, 4);
const pubs = (await getPublications()).filter((x) => x.data.featured);
const f = figures(lang);
---
<Base lang={lang} route="">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label">{p.role} · {p.location}</p>
        <h1>{p.headline}</h1>
        <p class="intro">{p.intro}</p>
        <div class="links">
          <a href={url(lang, 'research')}>{t.readMore}</a>
          <a href={p.cv_file}>{t.cv.download}</a>
          <a href={`https://orcid.org/${p.orcid}`}>ORCID</a>
          <a href={`https://github.com/${p.github}`}>GitHub</a>
        </div>
      </div>
      <figure class="portrait">
        <img src={p.photo} alt={p.photo_alt} width="800" height="1141" loading="eager" />
        <figcaption class="meta">{p.photo_caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <h2 class="label">{t.currently}</h2>
      <ul class="now">
        {p.currently.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <h2 class="label">{t.highlights}</h2>
      <div>
        <ol class="entries">
          {highlights.map((n) => (
            <li class="entry">
              <div class="when">{monthYear(n.data.date, lang)}</div>
              <div>
                <h3>{n.data.title}</h3>
                <div class="body" set:html={n.rendered?.html} />
              </div>
            </li>
          ))}
        </ol>
        <a class="more" href={url(lang, 'news')}>{t.allNews} →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <h2 class="label">{t.researchLead}</h2>
      <div>
        <ol class="themes">
          {p.themes.slice(0, 3).map((th, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{th.title}</h3>
              {th.question && <p class="q">{th.question}</p>}
            </li>
          ))}
        </ol>
        <div class="figs">
          <BarFigure n={1} figLabel={t.fig} sourceLabel={t.source} {...f.hiv} />
          <BarFigure n={2} figLabel={t.fig} sourceLabel={t.source} {...f.togo} />
        </div>
        <a class="more" href={url(lang, 'research')}>{t.readMore} →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <h2 class="label">{t.selectedWork}</h2>
      <div>
        {work.map((w) => <ProjectItem project={w} lang={lang} />)}
        <a class="more" href={url(lang, 'projects')}>{t.allProjects} →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <h2 class="label">{t.selectedPubs}</h2>
      <div>
        <ol class="entries">{pubs.map((x) => <PubItem pub={x} lang={lang} />)}</ol>
        <a class="more" href={url(lang, 'publications')}>{t.allPubs} →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); padding-top: clamp(40px, 7vw, 88px); padding-bottom: clamp(40px, 6vw, 72px); align-items: end; }
  h1 { font-size: clamp(42px, 6.6vw, 78px); line-height: 1.02; margin: 18px 0 28px; letter-spacing: -0.02em; }
  .intro { font-size: 19px; color: var(--ink-2); max-width: 58ch; }
  .portrait { margin: 0; }
  .portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; filter: saturate(0.9); }
  .portrait figcaption { margin-top: 10px; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 360px; }
  }
  .now { list-style: none; margin: 0; padding: 0; font-family: var(--serif); font-size: 22px; line-height: 1.4; }
  .now li { padding: 0 0 14px; }
  .now li + li { border-top: 1px solid var(--rule); padding-top: 14px; }
  .body :global(p) { color: var(--ink-2); margin: 0; }
  .themes { list-style: none; margin: 0 0 48px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .themes li { border-top: 2px solid var(--ink); padding-top: 14px; }
  .num { font-family: var(--mono); font-size: 13px; color: var(--accent); }
  .themes h3 { font-size: 24px; margin: 6px 0 10px; }
  .q { font-family: var(--serif); font-style: italic; color: var(--ink-2); margin: 0; }
  .figs { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  @media (max-width: 900px) { .themes, .figs { grid-template-columns: 1fr; } }
</style>
