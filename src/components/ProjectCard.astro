---
import { ui, type Lang } from '../lib/i18n';
interface Props { project: { data: any; slug: string }; lang: Lang }
const { project, lang } = Astro.props;
const t = ui[lang];
const d = project.data;
const href = d.demo ?? d.code;
---
<article class="card" id={project.slug}>
  {d.image ? (
    <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
      <img src={d.image} alt={d.image_alt ?? ''} loading="lazy" />
    </a>
  ) : (
    <div class="thumb plain"><h3 class="tile-title">{d.title}</h3></div>
  )}
  <div class="content">
    <div class="meta">{[d.years, d.stack.join(' · ')].filter(Boolean).join('  ·  ')}</div>
    {d.image && <h3>{d.title}</h3>}
    {d.context && <p class="context">{d.context}</p>}
    <p>{d.summary}</p>
    {(d.demo || d.code || d.download) && (
      <div class="links">
        {d.demo && <a href={d.demo}>{d.demo_label ?? t.live}</a>}
        {d.download && <a href={d.download}>{d.download_label ?? 'Download'}</a>}
        {d.code && <a href={d.code}>{t.code}</a>}
      </div>
    )}
  </div>
</article>

<style>
  .tile-title { color: #fff; font-size: 28px !important; }
  .context { font-style: italic; font-family: var(--serif); font-size: 17px; color: var(--muted) !important; }
</style>
